# Скопируй этот файл в .env и заполни

PORT=8080

# Postgres из Homebrew: пользователь = имя пользователя на Mac, пароль не нужен
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clipora
DB_USER=munarevaa
DB_PASSWORD=

# Куда складывать видео
DATA_DIR=data

# Ключ из Google AI Studio (aistudio.google.com → Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Запасная модель, если основная перегружена или кончился её лимит.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# whisper.cpp
WHISPER_BIN=whisper-cli
WHISPER_MODEL=/Users/munarevaa/clipora-models/ggml-large-v3-turbo-q5_0.bin

FFMPEG=ffmpeg
FFPROBE=ffprobe
FPCALC=fpcalc

# Сколько роликов обрабатывать одновременно
WORKERS=1

# Какой AI использовать: gemini или openai (Ollama на этом Mac, OpenRouter, DeepSeek и др.)
AI_PROVIDER=gemini

# Прокси для AI, например прокси твоего VPN: 127.0.0.1:7890
AI_PROXY=

# Для AI_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen3:8b

# Почты админов через запятую. Пусто — админ самый первый зарегистрированный аккаунт.
ADMIN_EMAILS=
